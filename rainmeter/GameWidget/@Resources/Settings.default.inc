; Game Widget appearance. Easiest to change from the cog next to the panel's title.
; Colors are R,G,B (each 0-255); opacities are 0 (invisible) to 255 (solid). Delete a line for its default.
; This file is yours: it isn't overwritten by updates (the defaults live in Settings.default.inc).
[Variables]
; Any installed font family
Font=Segoe UI

; Font for the 'Games' title
TitleFont=Segoe UI

; Panel background
BackgroundColor=17,18,23

; 0 = invisible, 255 = solid
BackgroundOpacity=232

; Panel outline
BorderColor=255,255,255

BorderOpacity=20

; Game names, hours, title
TextColor=234,236,242

; Section labels, 'total' / 'ago' notes, update time
MutedTextColor=140,146,162

; Warning line under the title
WarningColor=238,180,90

; Bars under 'Last 2 weeks'
RecentBarColor=122,162,247

; Bars under 'Most played'
MostPlayedBarColor=122,162,247

MostPlayedBarOpacity=150

; Bars under 'Gathering dust'
DustBarColor=222,172,92

; Empty part of each bar
BarTrackColor=255,255,255

BarTrackOpacity=14

; Highlight on the row under the mouse
RowHoverColor=255,255,255

RowHoverOpacity=14

; 'What should I play?' button
ButtonColor=217,119,87

; Button under the mouse
ButtonHoverColor=231,141,110

; Button label
ButtonTextColor=255,255,255
